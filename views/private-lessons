<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Private Lesson Schedule</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <h1>Private Lesson Schedule</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <% for (let date of dates) { %>
      <h2><%= date %></h2>
      <table border="1" cellspacing="0" cellpadding="5">
        <tr>
          <th>Time</th>
          <th>Duration (mins)</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
        <% schedule[date].forEach(slot => { %>
          <tr>
            <td><%= slot.start %></td>
            <td><%= slot.duration %></td>
            <td>
              <% if (slot.booked) { %>
                Booked
              <% } else { %>
                Available
              <% } %>
            </td>
            <td>
              <% if (!slot.booked) { %>
                <form action="/book-private-lesson" method="POST">
                  <input type="hidden" name="date" value="<%= date %>">
                  <input type="hidden" name="startTime" value="<%= slot.start %>">
                  <input type="hidden" name="duration" value="<%= slot.duration %>">
                  <input type="text" name="note" placeholder="Optional note">
                  <label>
                    <input type="checkbox" name="payment"> Payment made
                  </label>
                  <button type="submit">Book</button>
                </form>
              <% } else { %>
                <em>Slot booked</em>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </table>
    <% } %>
  </main>
</body>
</html>