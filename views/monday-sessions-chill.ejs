<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Monday Sessions: Chill</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* Additional styles for Monday Sessions page */
    .session-card {
      max-width: 800px;
      margin: 20px auto;
      padding: 20px;
      border: 2px solid #8B4513;
      border-radius: 10px;
      background-color: #fff8dc;
    }
    .session-card h2 {
      color: #8B4513;
      margin-bottom: 10px;
    }
    .class-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .class-list li {
      padding: 8px 0;
      border-bottom: 1px solid #ddd;
      font-size: 1.1em;
    }
    .class-list li:last-child {
      border-bottom: none;
    }
    .total-container {
      margin-top: 20px;
      padding: 15px;
      background-color: #e0dcd4;
      text-align: center;
      border-radius: 5px;
    }
    .total-container .total-amount {
      font-size: 2.5em;
      font-weight: bold;
      color: #8B4513;
    }
    .confirm-button {
      display: block;
      width: 100%;
      padding: 15px;
      background-color: #8B4513;
      color: #fff;
      font-size: 1.5em;
      border: none;
      border-radius: 5px;
      margin-top: 15px;
      cursor: pointer;
    }
    .confirm-button:hover {
      background-color: #A0522D;
    }
  </style>
</head>
<body>
  <header>
    <h1>Monday Sessions: Chill</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <!-- Card for Monday Sessions -->
    <div class="session-card">
      <h2>Available Lessons for Monday</h2>
      <ul class="class-list" id="class-list">
        <!-- Monday classes will be inserted here -->
      </ul>
      <div class="total-container">
        Total: <span class="total-amount" id="total-amount">$0.00</span>
      </div>
      <button class="confirm-button" id="confirm-button">Confirm</button>
    </div>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // For this demo, we assume Monday sessions are stored in localStorage under "mondayCart"
      // In a real app, you'd get this data from the server.
      let mondayCart = JSON.parse(localStorage.getItem('mondayCart')) || [];
      
      // If there are no Monday classes booked yet, insert some sample data.
      if (mondayCart.length === 0) {
        mondayCart = [
          { className: "Old-Time Morning Fiddle Groove", time: "8:00 AM", price: 95 },
          { className: "Twin Fiddles", time: "9:00 AM", price: 95 },
          { className: "Swing Time", time: "10:00 AM", price: 95 }
        ];
        localStorage.setItem('mondayCart', JSON.stringify(mondayCart));
      }
      
      const classListEl = document.getElementById('class-list');
      const totalAmountEl = document.getElementById('total-amount');
      
      function renderMondayCart() {
        classListEl.innerHTML = '';
        let total = 0;
        mondayCart.forEach(item => {
          total += item.price;
          const li = document.createElement('li');
          li.textContent = `${item.className} @ ${item.time} - $${item.price.toFixed(2)}`;
          classListEl.appendChild(li);
        });
        totalAmountEl.textContent = `$${total.toFixed(2)}`;
      }
      
      renderMondayCart();
      
      // When Confirm button is clicked, redirect to Fiddler's Log page
      document.getElementById('confirm-button').addEventListener('click', function() {
        window.location.href = "/fiddlers-log";
      });
    });
  </script>
</body>
</html>