<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Monday Sessions: Chill</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* Combined Styles for Monday Sessions Page */
    .session-card {
      max-width: 800px;
      margin: 20px auto;
      padding: 20px;
      border: 2px solid #8B4513;
      border-radius: 10px;
      background-color: #fff8dc;
    }
    .session-card h2 {
      color: #8B4513;
      margin-bottom: 10px;
    }
    .class-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .class-list li {
      padding: 8px 0;
      border-bottom: 1px solid #ddd;
      font-size: 1.1em;
    }
    .class-list li:last-child {
      border-bottom: none;
    }
    .total-container {
      margin-top: 20px;
      padding: 15px;
      background-color: #e0dcd4;
      text-align: center;
      border-radius: 5px;
    }
    .total-container .total-amount {
      font-size: 2.5em;
      font-weight: bold;
      color: #8B4513;
    }
    .confirm-button {
      display: block;
      width: 100%;
      padding: 15px;
      background-color: #8B4513;
      color: #fff;
      font-size: 1.5em;
      border: none;
      border-radius: 5px;
      margin-top: 15px;
      cursor: pointer;
    }
    .confirm-button:hover {
      background-color: #A0522D;
    }
    .reservation-info {
      margin-top: 20px;
      font-size: 14px;
      color: #555;
    }
  </style>
</head>
<body>
  <header>
    <h1>Monday Sessions: Chill</h1>
    <p class="session-date" style="text-align:center; font-size:1.2em; margin:5px 0;">
      February 17, 2025
    </p>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <!-- Session Card: Groups all Monday classes in one container -->
    <div class="session-card">
      <h2>Available Lessons for Monday</h2>
      <ul class="class-list" id="class-list">
        <!-- Monday classes will be inserted here dynamically -->
      </ul>
      <div class="total-container">
        Total: <span class="total-amount" id="total-amount">$0.00</span>
      </div>
      <button class="confirm-button" id="confirm-button">Confirm</button>
      <div class="reservation-info">
        <p><strong>To reserve a lesson, please follow these steps:</strong></p>
        <ol>
          <li>Select the lessons you wish to take.</li>
          <li>Make payment using Zelle (chadmanning@gmail.com), Venmo (chad-manning-18), Cash or Check outside of the Fiddle Shack.</li>
          <li>The total displayed is the amount due for the lessons booked in the current month.</li>
          <li>If you have any questions, please contact the Fiddle Shack.</li>
        </ol>
      </div>
    </div>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Try to load Monday sessions from localStorage under "mondayCart".
      // If not present or empty, load sample data.
      let mondayCart = JSON.parse(localStorage.getItem('mondayCart'));
      if (!mondayCart || mondayCart.length === 0) {
        mondayCart = [
          { className: "Old-Time Morning Fiddle Groove", time: "8:00 AM", price: 95 },
          { className: "Twin Fiddles", time: "9:00 AM", price: 95 },
          { className: "Swing Time", time: "10:00 AM", price: 95 },
          { className: "Bluegrass Instrumentals: The Classics", time: "11:00 AM", price: 95 },
          { className: "Bluegrass Jam", time: "1:00 PM", price: 35 }
        ];
        localStorage.setItem('mondayCart', JSON.stringify(mondayCart));
      }
      
      const classListEl = document.getElementById('class-list');
      const totalAmountEl = document.getElementById('total-amount');
      
      function renderMondayCart() {
        classListEl.innerHTML = '';
        let total = 0;
        mondayCart.forEach(item => {
          total += item.price;
          const li = document.createElement('li');
          li.textContent = `${item.className} @ ${item.time} - $${item.price.toFixed(2)}`;
          classListEl.appendChild(li);
        });
        totalAmountEl.textContent = `$${total.toFixed(2)}`;
      }
      
      renderMondayCart();
      
      // When the Confirm button is clicked, redirect to Fiddler's Log page.
      document.getElementById('confirm-button').addEventListener('click', function() {
        window.location.href = "/fiddlers-log";
      });
    });
  </script>
</body>
</html>