<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Monday Sessions: Chill</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <h1>Monday Sessions: Chill</h1>
    <p class="session-date" style="text-align:center; font-size:1.2em; margin:5px 0;">
      February 17, 2025
    </p>
    <nav>
      <a href="/">Home</a>
    </nav>
  </header>
  <main>
    <!-- CLASS SCHEDULE -->
    <section class="class-schedule">
      <!-- Repeat for each class card -->
      <div class="class-card">
        <h2>Oldtime Morning Groove</h2>
        <p>9:00 - 9:55 AM | $25</p>
        <ul class="tunes-list">
          <li>Swannanoa Waltz</li>
          <li>Cumberland Gap</li>
          <li>Tippin Back the Corn</li>
        </ul>
        <button>Select</button>
      </div>
      <!-- Add other class cards here -->
    </section>

    <!-- CART SECTION -->
    <section class="cart">
      <h2>Your Classes</h2>
      <ul id="cart-items"></ul>
      <p id="cart-total">Total: $0</p>
      <button id="checkout-button">Checkout</button>

      <div class="reservation-info">
        <p><strong>To reserve a spot, please follow these steps:</strong></p>
        <ol>
          <li>Select classes</li>
          <li>Make Payment with Zelle or Venmo (outside of the fiddle shack)</li>
          <li>Email if paying by check or cash before Monday</li>
          <li>Note: Classes priced at $25 drop to <strong>$20</strong> per class once four or more are selected.</li>
        </ol>
        <p><strong>Zelle:</strong> chadmanning@gmail.com</p>
        <p><strong>Venmo:</strong> chad-manning-18</p>
      </div>
    </section>
  </main>
  <script src="/tapp.js"></script>
</body>
</html>