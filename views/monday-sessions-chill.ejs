<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Comfortable Monday Jams</title>
  <link rel="stylesheet" href="/style.css" />
  <style>
    /* Styles for individual class cards */
    .class-schedule {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-bottom: 30px;
    }
    .class-card {
      background-color: #fff;
      border: 1px solid #ddd;
      border-radius: 5px;
      padding: 15px;
      width: 300px;
      box-shadow: 2px 2px 6px rgba(0,0,0,0.1);
    }
    .class-card h2 {
      font-size: 1.3em;
      margin-top: 0;
      color: #8B4513;
    }
    .class-card p, .class-card ul {
      margin: 5px 0;
      font-size: 1em;
    }
    .class-card ul.tunes-list {
      padding-left: 20px;
    }
    .class-card button {
      display: block;
      margin: 10px auto 0 auto;
      padding: 8px 12px;
      background-color: #8B4513;
      color: #fff;
      border: none;
      border-radius: 3px;
      cursor: pointer;
    }
    .class-card button:hover {
      background-color: #A0522D;
    }
    /* New Cart Section Styles */
    .cart {
      max-width: 800px;
      margin: 20px auto;
      padding: 20px;
      border: 2px solid #8B4513;
      border-radius: 10px;
      background-color: #fff8dc;
    }
    .empty-message {
      text-align: center;
      font-style: italic;
      color: #777;
      margin: 10px 0;
    }
    .total-container {
      margin-top: 20px;
      padding: 15px;
      background-color: #e0dcd4;
      text-align: center;
      border-radius: 5px;
    }
    .total-container .total-amount {
      font-size: 2.5em;
      font-weight: bold;
      color: #8B4513;
    }
    .confirm-button {
      display: block;
      width: 100%;
      padding: 15px;
      background-color: #8B4513;
      color: #fff;
      font-size: 1.5em;
      border: none;
      border-radius: 5px;
      margin-top: 15px;
      cursor: pointer;
    }
    .confirm-button:hover {
      background-color: #A0522D;
    }
    .reservation-info {
      margin-top: 20px;
      font-size: 14px;
      color: #555;
    }
  </style>
</head>
<body>
  <header>
    <h1>Comfortable Monday Jams</h1>
    <p class="session-date" style="text-align:center; font-size:1.2em; margin:5px 0;">February 17, 2025</p>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <!-- CLASS SCHEDULE: Individual class cards -->
    <section class="class-schedule">
      <!-- Card 1 -->
      <div class="class-card">
        <h2>Oldtime Morning Groove</h2>
        <p>9:00 - 9:55 AM | $25</p>
        <ul class="tunes-list">
          <li>Swannanoa Waltz</li>
          <li>Cumberland Gap</li>
          <li>Tippin Back the Corn</li>
        </ul>
        <button class="select-btn" data-classname="Oldtime Morning Groove" data-time="9:00 AM" data-price="25">Select</button>
      </div>
      <!-- Card 2 -->
      <div class="class-card">
        <h2>Twin Fiddles</h2>
        <p>10:00 - 10:55 AM | $25</p>
        <ul class="tunes-list">
          <li>Fireball Mail</li>
          <li>Goodbye Liza Jane</li>
          <li>Miss Molly</li>
        </ul>
        <button class="select-btn" data-classname="Twin Fiddles" data-time="10:00 AM" data-price="25">Select</button>
      </div>
      <!-- Card 3 -->
      <div class="class-card">
        <h2>Swing Time</h2>
        <p>11:00 - 11:55 AM | $25</p>
        <ul class="tunes-list">
          <li>12 Bar Blues</li>
          <li>Dinah</li>
          <li>Minor Swing</li>
        </ul>
        <button class="select-btn" data-classname="Swing Time" data-time="11:00 AM" data-price="25">Select</button>
      </div>
      <!-- Card 4 -->
      <div class="class-card">
        <h2>Bluegrass Instrumentals: The Classics</h2>
        <p>12:00 - 12:55 PM | $25</p>
        <ul class="tunes-list">
          <li>Clinch Mountain Backstep</li>
          <li>Soldier's Joy</li>
          <li>Whiskey Before Breakfast</li>
        </ul>
        <button class="select-btn" data-classname="Bluegrass Instrumentals: The Classics" data-time="12:00 PM" data-price="25">Select</button>
      </div>
      <!-- Card 5 -->
      <div class="class-card">
        <h2>Bluegrass Jam</h2>
        <p>1:00 - 2:30 PM | $35</p>
        <ul class="tunes-list">
          <li>Selected by musicians</li>
        </ul>
        <button class="select-btn" data-classname="Bluegrass Jam" data-time="1:00 PM" data-price="35">Select</button>
      </div>
    </section>

    <!-- NEW CART SECTION: Displays only classes the user has selected -->
    <section class="cart">
      <h2>Your Sessions</h2>
      <div id="cart-list">
        <!-- Cart items will be inserted here -->
      </div>
      <div class="total-container">
        Total: <span class="total-amount" id="total-amount">$0.00</span>
      </div>
      <button class="confirm-button" id="confirm-button">Confirm</button>
      <div class="reservation-info">
        <p><strong>To reserve your sessions, please follow these steps:</strong></p>
        <ol>
          <li>Select classes by clicking the "Select" button on a class card. (Click again to deselect.)</li>
          <li>Make Payment with Zelle (chadmanning@gmail.com), Venmo (chad-manning-18), Cash, or Check outside of the Fiddle Shack.</li>
          <li>The total displayed is the amount due for the lessons you have selected. Note: When four or more classes are selected, each $25 class is discounted to $20 (Bluegrass Jam remains $35).</li>
          <li>If you have any questions, please contact the Fiddle Shack.</li>
        </ol>
      </div>
    </section>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Retrieve the Monday sessions cart from localStorage (default to an empty array)
      let mondayCart = JSON.parse(localStorage.getItem('mondayCart')) || [];
      
      const cartListEl = document.getElementById('cart-list');
      const totalAmountEl = document.getElementById('total-amount');
      
      // Function to render the cart with discount logic:
      // If 4 or more classes are selected, each $25 class is discounted to $20.
      function renderMondayCart() {
        cartListEl.innerHTML = '';
        if (mondayCart.length === 0) {
          cartListEl.innerHTML = '<p class="empty-message">No classes selected.</p>';
          totalAmountEl.textContent = '$0.00';
          return;
        }
        let total = 0;
        mondayCart.forEach(item => {
          let originalPrice = parseFloat(item.price);
          let price = originalPrice;
          let discountNote = '';
          if (mondayCart.length >= 4 && originalPrice === 25) {
            price = 20;
            discountNote = ' (Discount applied)';
          }
          total += price;
          const div = document.createElement('div');
          div.style.padding = "5px 0";
          div.style.borderBottom = "1px solid #ddd";
          div.textContent = `${item.className} @ ${item.time} - $${price.toFixed(2)}${discountNote}`;
          cartListEl.appendChild(div);
        });
        totalAmountEl.textContent = `$${total.toFixed(2)}`;
      }
      
      renderMondayCart();
      
      // Attach event listeners to all "Select" buttons on the individual class cards.
      const selectButtons = document.querySelectorAll('.select-btn');
      selectButtons.forEach(button => {
        button.addEventListener('click', function() {
          const className = this.getAttribute('data-classname');
          const time = this.getAttribute('data-time');
          const price = this.getAttribute('data-price');
          const selectedClass = { className, time, price };
          
          // Check if this class is already in the cart.
          const index = mondayCart.findIndex(item => item.className === className && item.time === time);
          if (index === -1) {
            // Add the class.
            mondayCart.push(selectedClass);
            this.textContent = "Deselect";
          } else {
            // Remove the class.
            mondayCart.splice(index, 1);
            this.textContent = "Select";
          }
          localStorage.setItem('mondayCart', JSON.stringify(mondayCart));
          renderMondayCart();
        });
      });
      
      // When the Confirm button is clicked, redirect to the Fiddler's Log page.
      document.getElementById('confirm-button').addEventListener('click', function() {
        window.location.href = "/fiddlers-log";
      });
    });
  </script>
</body>
</html>