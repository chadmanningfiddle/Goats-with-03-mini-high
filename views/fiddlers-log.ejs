<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiddler's Log</title>
    <link rel="stylesheet" href="/style.css">
    <!-- Add React and ReactDOM scripts -->
    <script src="https://unpkg.com/react@17/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@17/umd/react-dom.development.js"></script>
    <!-- Add Babel for JSX support -->
    <script src="https://unpkg.com/babel-standalone@6/babel.min.js"></script>
</head>
<body>
    <header>
        <h1>Fiddler's Log</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/monday-sessions">Monday Sessions</a>
            <a href="/private-lessons">Private Lessons</a>
            <a href="#" onclick="logout()">Logout</a>
        </nav>
    </header>

    <div id="fiddlers-log-root"></div>

    <script type="text/babel">
        // Mount the React component
        ReactDOM.render(
            <FiddlersLog />,
            document.getElementById('fiddlers-log-root')
        );
    </script>
</body>
</html>