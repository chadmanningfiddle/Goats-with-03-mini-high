<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fiddler's Log - Monday Sessions</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .monday-card {
      max-width: 800px;
      margin: 20px auto;
      padding: 20px;
      border: 2px solid #8B4513;
      border-radius: 10px;
      background-color: #fff8dc;
    }
    .monday-card h2 {
      color: #8B4513;
      margin-bottom: 10px;
    }
    .session-item {
      border-bottom: 1px solid #ddd;
      padding: 8px 0;
      font-size: 1.1em;
      position: relative;
    }
    .session-item:last-child {
      border-bottom: none;
    }
    .session-item .status {
      position: absolute;
      right: 0;
      top: 8px;
      font-weight: bold;
    }
    .total-container {
      background-color: #e0dcd4;
      text-align: center;
      padding: 15px;
      border-radius: 5px;
      margin-top: 20px;
      font-size: 2em;
      color: #8B4513;
    }
    .empty-message {
      text-align: center;
      font-style: italic;
      color: #777;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <header>
    <h1>Fiddler's Log</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <div class="monday-card">
      <h2>Monday Sessions</h2>
      <div id="monday-card-content">
        <!-- Monday session items will be rendered here -->
      </div>
      <div class="total-container">
        Total: <span id="monday-total">$0.00</span>
      </div>
    </div>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Retrieve Monday sessions from localStorage (from the mondayCart key).
      // This page does not pre-populate sample data.
      let mondayCart = JSON.parse(localStorage.getItem('mondayCart')) || [];
      
      const mondayCardContent = document.getElementById('monday-card-content');
      const mondayTotalEl = document.getElementById('monday-total');
      
      function renderMondayCard() {
        mondayCardContent.innerHTML = '';
        if (mondayCart.length === 0) {
          mondayCardContent.innerHTML = '<p class="empty-message">No sessions booked for Monday.</p>';
          mondayTotalEl.textContent = '$0.00';
          return;
        }
        let total = 0;
        mondayCart.forEach(item => {
          let originalPrice = parseFloat(item.price);
          let price = originalPrice;
          if (mondayCart.length >= 4 && originalPrice === 25) {
            price = 20;
          }
          total += price;
          // For payment status, assume a "paid" property (default false if not set)
          let paidStatus = item.paid ? 'Paid' : 'Not Paid';
          const div = document.createElement('div');
          div.classList.add('session-item');
          div.innerHTML = `${item.className} @ ${item.time} - $${price.toFixed(2)} <span class="status">${paidStatus}</span>`;
          mondayCardContent.appendChild(div);
        });
        mondayTotalEl.textContent = `$${total.toFixed(2)}`;
      }
      
      renderMondayCard();
    });
  </script>
</body>
</html>