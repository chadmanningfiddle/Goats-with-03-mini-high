<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fiddler's Log - Monday Sessions</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* Fiddler's Log Page Styles */
    body {
      background-color: #fefefe;
      font-family: Arial, sans-serif;
      color: #333;
      margin: 0;
      padding: 0;
    }
    header {
      background-color: #8B4513;
      color: #fff;
      padding: 10px;
      text-align: center;
    }
    nav a {
      color: #fff;
      margin: 0 10px;
      text-decoration: none;
    }
    main {
      max-width: 800px;
      margin: 20px auto;
      padding: 10px;
    }
    .monday-card {
      border: 2px solid #8B4513;
      border-radius: 10px;
      background-color: #fff8dc;
      padding: 20px;
      margin-bottom: 20px;
    }
    .monday-card h2 {
      color: #8B4513;
      margin-bottom: 10px;
    }
    .session-item {
      border-bottom: 1px solid #ddd;
      padding: 8px 0;
      font-size: 1.1em;
      position: relative;
    }
    .session-item:last-child {
      border-bottom: none;
    }
    .session-item .status {
      position: absolute;
      right: 0;
      top: 8px;
      font-weight: bold;
    }
    .total-container {
      background-color: #e0dcd4;
      text-align: center;
      padding: 15px;
      border-radius: 5px;
      margin-top: 20px;
      font-size: 2em;
      color: #8B4513;
    }
    .empty-message {
      text-align: center;
      font-style: italic;
      color: #777;
      margin: 10px 0;
    }
  </style>
</head>
<body>
  <header>
    <h1>Fiddler's Log</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <!-- Monday Card: Displays the Monday sessions for the current day -->
    <div class="monday-card">
      <h2>Monday Sessions</h2>
      <div id="monday-card-content">
        <!-- Monday session items will be rendered here -->
      </div>
      <div class="total-container">
        Total: <span id="monday-total">$0.00</span>
      </div>
    </div>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Retrieve Monday sessions from localStorage; if nothing exists, default to an empty array.
      // (We no longer pre-populate sample data on the Fiddler's Log page.)
      let mondayCart = JSON.parse(localStorage.getItem('mondayCart')) || [];
      
      const mondayCardContent = document.getElementById('monday-card-content');
      const mondayTotalEl = document.getElementById('monday-total');
      
      function renderMondayCard() {
        mondayCardContent.innerHTML = '';
        if (mondayCart.length === 0) {
          mondayCardContent.innerHTML = '<p class="empty-message">No sessions booked for Monday.</p>';
          mondayTotalEl.textContent = '$0.00';
          return;
        }
        let total = 0;
        mondayCart.forEach(item => {
          // Parse the original price.
          let originalPrice = parseFloat(item.price);
          // Apply discount: if 4 or more classes are selected and this class costs $25, discount it to $20.
          let price = (mondayCart.length >= 4 && originalPrice === 25) ? 20 : originalPrice;
          total += price;
          // Determine payment status; if not set, default to false.
          let paidStatus = item.paid ? 'Paid' : 'Not Paid';
          // Create a session item element.
          const div = document.createElement('div');
          div.classList.add('session-item');
          div.innerHTML = `${item.className} @ ${item.time} - $${price.toFixed(2)} <span class="status">${paidStatus}</span>`;
          mondayCardContent.appendChild(div);
        });
        mondayTotalEl.textContent = `$${total.toFixed(2)}`;
      }
      
      renderMondayCard();
      
      // OPTIONAL: If you wish to allow users to update payment status on this page,
      // you could add event listeners (e.g., a checkbox or a button) for each session item.
      // For now, this page only displays the stored paid status.
    });
  </script>
</body>
</html>