<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fiddler's Log - Your Lessons</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* New Fiddler's Log Styles */
    body {
      background-color: #fefefe;
      color: #333;
      font-family: Arial, sans-serif;
    }
    header {
      background-color: #8B4513;
      color: #fff;
      padding: 10px;
      text-align: center;
    }
    nav a {
      color: #fff;
      margin: 0 10px;
      text-decoration: none;
    }
    main {
      max-width: 800px;
      margin: 20px auto;
      padding: 10px;
    }
    h2 {
      color: #8B4513;
    }
    .lesson {
      border: 1px solid #ddd;
      border-radius: 5px;
      padding: 15px;
      margin-bottom: 15px;
      background-color: #fff;
      box-shadow: 2px 2px 6px rgba(0,0,0,0.1);
    }
    .lesson h3 {
      margin: 0 0 10px 0;
      color: #8B4513;
    }
    .lesson p {
      margin: 5px 0;
    }
    .notes-area {
      width: 100%;
      height: 80px;
      border: 1px solid #ccc;
      border-radius: 4px;
      padding: 5px;
      font-size: 14px;
      resize: vertical;
    }
    .save-note {
      background-color: #8B4513;
      color: #fff;
      border: none;
      padding: 8px 12px;
      border-radius: 4px;
      cursor: pointer;
      margin-top: 5px;
    }
    .save-note:hover {
      background-color: #A0522D;
    }
    .empty {
      text-align: center;
      font-style: italic;
      color: #777;
      margin-top: 30px;
    }
  </style>
</head>
<body>
  <header>
    <h1>Fiddler's Log</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <h2>Your Lessons</h2>
    <div id="lessons-container">
      <!-- Lessons will be inserted here -->
    </div>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Retrieve lessons from localStorage; if none exist, use sample data.
      let lessons = JSON.parse(localStorage.getItem('bookings')) || [];
      
      // If there are no lessons, insert sample lessons so the page isn’t blank.
      if (lessons.length === 0) {
        lessons = [
          {
            date: new Date().toISOString(), // today
            time: "8:00 AM",
            recurring: false,
            frequency: "",
            price: 95
          },
          {
            date: new Date(new Date().setDate(new Date().getDate() + 1)).toISOString(), // tomorrow
            time: "9:00 AM",
            recurring: true,
            frequency: "weekly",
            price: 95
          },
          {
            date: new Date(new Date().setDate(new Date().getDate() - 3)).toISOString(), // 3 days ago
            time: "10:00 AM",
            recurring: false,
            frequency: "",
            price: 95
          }
        ];
        localStorage.setItem('bookings', JSON.stringify(lessons));
      }
      
      // Sort lessons by date.
      lessons.sort((a, b) => new Date(a.date) - new Date(b.date));
      
      const container = document.getElementById('lessons-container');
      if (lessons.length === 0) {
        container.innerHTML = '<p class="empty">No lessons booked yet.</p>';
      } else {
        lessons.forEach((lesson, index) => {
          const lessonId = 'lesson-' + index;
          const lessonDate = new Date(lesson.date);
          let lessonHtml = `
            <div class="lesson" id="${lessonId}">
              <h3>${lessonDate.toDateString()} @ ${lesson.time}${lesson.recurring ? ' (' + lesson.frequency + ')' : ''}</h3>
              <p>Price: $${lesson.price.toFixed(2)} per lesson</p>
              <textarea class="notes-area" id="${lessonId}-notes" placeholder="Enter notes for this lesson..."></textarea>
              <br>
              <button class="save-note" data-lessonid="${lessonId}">Save Note</button>
            </div>
          `;
          container.innerHTML += lessonHtml;
          // Populate textarea if note exists.
          const savedNote = localStorage.getItem(lessonId + '-note');
          if (savedNote) {
            document.getElementById(lessonId + '-notes').value = savedNote;
          }
        });
      }
      
      // Add event listeners to Save buttons.
      const saveButtons = document.querySelectorAll('.save-note');
      saveButtons.forEach(button => {
        button.addEventListener('click', function() {
          const lessonId = this.getAttribute('data-lessonid');
          const note = document.getElementById(lessonId + '-notes').value;
          localStorage.setItem(lessonId + '-note', note);
          alert('Note saved for ' + lessonId);
        });
      });
    });
  </script>
</body>
</html>