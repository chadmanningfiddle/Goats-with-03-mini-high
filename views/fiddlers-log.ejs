<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fiddler's Log - Private Lessons</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* Fiddler's Log Page Styles */
    body {
      background-color: #fefefe;
      font-family: Arial, sans-serif;
      color: #333;
      margin: 0;
      padding: 0;
    }
    header {
      background-color: #8B4513;
      color: #fff;
      padding: 10px;
      text-align: center;
    }
    nav a {
      color: #fff;
      margin: 0 10px;
      text-decoration: none;
    }
    main {
      max-width: 800px;
      margin: 20px auto;
      padding: 10px;
    }
    .monday-card {
      border: 2px solid #8B4513;
      border-radius: 10px;
      background-color: #fff8dc;
      padding: 20px;
      margin-bottom: 20px;
    }
    .monday-card h2 {
      color: #8B4513;
      margin-bottom: 10px;
    }
    .session-item {
      border-bottom: 1px solid #ddd;
      padding: 8px 0;
      font-size: 1.1em;
      position: relative;
    }
    .session-item:last-child {
      border-bottom: none;
    }
    .session-item .status {
      position: absolute;
      right: 0;
      top: 8px;
      font-weight: bold;
    }
    .total-container {
      background-color: #e0dcd4;
      text-align: center;
      padding: 15px;
      border-radius: 5px;
      margin-top: 10px;
      font-size: 1.8em;
      color: #8B4513;
    }
    .overall-total {
      text-align: center;
      font-size: 2.5em;
      font-weight: bold;
      color: #8B4513;
      margin-top: 20px;
    }
    .empty-message {
      text-align: center;
      font-style: italic;
      color: #777;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <header>
    <h1>Fiddler's Log</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <div id="lessons-container">
      <!-- Monday cards (grouped by date) will be rendered here -->
    </div>
    <div class="overall-total" id="overall-total">
      Overall Total: $0.00
    </div>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Retrieve the private lessons cart from localStorage.
      // Ensure that your booking code (in your Monday session pages) saves an array of lesson objects under "privateLessonsCart"
      let lessons = JSON.parse(localStorage.getItem('privateLessonsCart')) || [];
      
      const lessonsContainer = document.getElementById('lessons-container');
      const overallTotalEl = document.getElementById('overall-total');
      
      // Group lessons by date using the lesson.date property.
      function groupByDate(lessons) {
        const groups = {};
        lessons.forEach(lesson => {
          // Convert the stored date into a date string (for grouping)
          const dateStr = new Date(lesson.date).toDateString();
          if (!groups[dateStr]) {
            groups[dateStr] = [];
          }
          groups[dateStr].push(lesson);
        });
        return groups;
      }
      
      // Render Monday cards grouped by date.
      function renderMondayCard() {
        lessonsContainer.innerHTML = '';
        if (lessons.length === 0) {
          lessonsContainer.innerHTML = '<p class="empty-message">No private lessons booked yet.</p>';
          overallTotalEl.textContent = 'Overall Total: $0.00';
          return;
        }
        
        // Group the lessons.
        const groups = groupByDate(lessons);
        // Sort the date groups chronologically.
        const sortedDates = Object.keys(groups).sort((a, b) => new Date(a) - new Date(b));
        
        let overallTotal = 0;
        sortedDates.forEach(dateStr => {
          const group = groups[dateStr];
          let groupTotal = 0;
          let cardHTML = '<div class="monday-card">';
          cardHTML += `<h2>${dateStr}</h2>`;
          
          group.forEach(lesson => {
            let origPrice = parseFloat(lesson.price);
            let price = origPrice;
            // Apply discount: if 4 or more lessons on that day and lesson costs $25, discount to $20.
            if (group.length >= 4 && origPrice === 25) {
              price = 20;
            }
            groupTotal += price;
            let status = lesson.paid ? 'Paid' : 'Not Paid';
            cardHTML += `<div class="session-item">
                           ${lesson.className} @ ${lesson.time} - $${price.toFixed(2)}
                           <span class="status">${status}</span>
                         </div>`;
          });
          cardHTML += `<div class="total-container">Group Total: $${groupTotal.toFixed(2)}</div>`;
          cardHTML += '</div>';
          
          lessonsContainer.innerHTML += cardHTML;
          overallTotal += groupTotal;
        });
        
        overallTotalEl.textContent = 'Overall Total: $' + overallTotal.toFixed(2);
      }
      
      renderMondayCard();
    });
  </script>
</body>
</html>