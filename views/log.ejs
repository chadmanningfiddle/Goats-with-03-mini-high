<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fiddler's Log</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* Fiddler's Log Styles */
    .lesson-item {
      border: 1px solid #ccc;
      padding: 10px;
      margin: 10px auto;
      border-radius: 5px;
      background-color: #fff;
      max-width: 600px;
    }
    .lesson-info {
      font-weight: bold;
      margin-bottom: 5px;
    }
    .notes-box {
      width: 100%;
      height: 80px;
      border: 1px solid #8B4513;
      border-radius: 5px;
      padding: 5px;
      resize: vertical;
      font-size: 14px;
    }
    .save-button {
      background-color: #8B4513;
      color: #fff;
      border: none;
      padding: 5px 10px;
      border-radius: 3px;
      cursor: pointer;
      margin-top: 5px;
    }
    .save-button:hover {
      background-color: #A0522D;
    }
    .empty-message {
      text-align: center;
      font-style: italic;
      color: #555;
      margin-top: 30px;
    }
  </style>
</head>
<body>
  <header>
    <h1>Fiddler's Log</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <section id="lessons-section">
      <h2>Your Lessons (Past &amp; Future)</h2>
      <!-- Lessons will be populated here -->
    </section>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Attempt to load booked lessons from localStorage
      let lessons = JSON.parse(localStorage.getItem('bookings')) || [];
      
      // If there are no lessons, insert some sample data so the page isn’t blank.
      if (lessons.length === 0) {
        // Sample lessons: You can adjust these as needed.
        lessons = [
          {
            date: new Date().toISOString(), // today
            time: "8:00 AM",
            recurring: false,
            frequency: "",
            price: 95
          },
          {
            date: new Date(new Date().setDate(new Date().getDate() + 1)).toISOString(), // tomorrow
            time: "9:00 AM",
            recurring: true,
            frequency: "weekly",
            price: 95
          },
          {
            date: new Date(new Date().setDate(new Date().getDate() - 3)).toISOString(), // 3 days ago
            time: "10:00 AM",
            recurring: false,
            frequency: "",
            price: 95
          }
        ];
        // Optionally save these sample lessons to localStorage so they persist:
        localStorage.setItem('bookings', JSON.stringify(lessons));
      }
      
      // Sort lessons by date
      lessons.sort((a, b) => new Date(a.date) - new Date(b.date));
      
      const lessonsSection = document.getElementById('lessons-section');
      
      // Function to generate a unique ID for each lesson based on its index.
      function getLessonId(index) {
        return 'lesson-' + index;
      }
      
      // Build the lesson list.
      if (lessons.length === 0) {
        lessonsSection.innerHTML += '<p class="empty-message">No lessons booked yet.</p>';
      } else {
        lessons.forEach((lesson, index) => {
          const lessonId = getLessonId(index);
          const lessonDiv = document.createElement('div');
          lessonDiv.classList.add('lesson-item');
          
          const lessonDate = new Date(lesson.date);
          let infoText = lessonDate.toDateString() + " @ " + lesson.time;
          if (lesson.recurring) {
            infoText += " (" + lesson.frequency + ")";
          }
          
          lessonDiv.innerHTML = `
            <div class="lesson-info">${infoText} - $${lesson.price.toFixed(2)} per lesson</div>
            <textarea id="${lessonId}-notes" class="notes-box" placeholder="Enter notes for this lesson..."></textarea>
            <br>
            <button class="save-button" data-lessonid="${lessonId}">Save Notes</button>
          `;
          
          lessonsSection.appendChild(lessonDiv);
          
          // If a note is already saved for this lesson, populate the textarea.
          const storedNote = localStorage.getItem(lessonId + '-note');
          if (storedNote) {
            document.getElementById(lessonId + '-notes').value = storedNote;
          }
        });
      }
      
      // Add event listeners to Save buttons.
      const saveButtons = document.querySelectorAll('.save-button');
      saveButtons.forEach(button => {
        button.addEventListener('click', function() {
          const lessonId = this.getAttribute('data-lessonid');
          const textarea = document.getElementById(lessonId + '-notes');
          const note = textarea.value;
          localStorage.setItem(lessonId + '-note', note);
          alert('Notes saved for this lesson.');
        });
      });
    });
  </script>
</body>
</html>